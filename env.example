# Copy this file to .env and fill in real values. .env is gitignored —
# never commit real credentials.

# HUD USER API — free account + token at https://www.huduser.gov/hudapi/public/login
HUD_API_TOKEN=

# Census API — free key at https://api.census.gov/data/key_signup.html
CENSUS_API_KEY=

# Snowflake
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_WAREHOUSE=NER_DEMO_WH
SNOWFLAKE_DATABASE=NER_DEMO
SNOWFLAKE_ROLE=
